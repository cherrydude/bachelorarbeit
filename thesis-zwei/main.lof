\contentsline {figure}{\numberline {3.1}{\ignorespaces Komponentenmodell der Scheduling-Visualisierungsanwendung. Die Benutzeroberfläche nutzt die fachliche Simulationslogik; Ergebnisse werden anschließend in Visualisierungs- und Vergleichskomponenten dargestellt.}}{9}{figure.3.1}%
\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Szenario-Generator zur Definition von Prozessdaten und Simulationsparametern.}}{19}{figure.5.1}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Ausgangszustand ohne Szenario und Algorithmus.}}{22}{figure.6.1}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Zustand nach dem Laden eines Szenarios ohne angewendeten Algorithmus.}}{23}{figure.6.2}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Fokusansicht mit Gantt-Zeitachse, Stack-Visualisierung und Kennzahlen.}}{23}{figure.6.3}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Detailansicht der Gantt-Zeitachse}}{24}{figure.6.4}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Detailansicht der Stack-Visualisierung mit aktivem und wartenden Prozess.}}{24}{figure.6.5}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Detailansicht der berechneten Kennzahlen eines Simulationslaufs.}}{25}{figure.6.6}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Gesamtübersicht der Vergleichsansicht mit Mini-Gantts und Bewertungsmatrix.}}{25}{figure.6.7}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Vergleichsübersicht mit nebeneinander dargestellten Mini-Gantts mehrerer Runs.}}{26}{figure.6.8}%
